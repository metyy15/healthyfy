{
  "name": "healthyfy-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "start": "tsx server.ts",
    "test:api": "node scripts/smoke-test.mjs",
    "test:render": "esbuild scripts/render-check.tsx --bundle --platform=node --format=esm --jsx=automatic --outfile=node_modules/.cache/render-check.mjs --log-level=warning --external:react --external:react-dom --external:lucide-react && node node_modules/.cache/render-check.mjs",
    "test:provider": "node scripts/provider-test.mjs",
    "test:agent": "bash scripts/test-agent.sh",
    "reset:demo": "node scripts/reset-demo.mjs",
    "start:dev": "bash scripts/start-dev.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "mongodb": "^6.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
