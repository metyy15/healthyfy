# ASI:One (Fetch.ai) - get a key at https://asi1.ai/developer
# The name is ASI_ONE_API_KEY in the ASI:One docs; ASI1_API_KEY also works.
ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=asi1

# Agentverse. Not needed for the mailbox flow: the mailbox is created
# for this agent's address from the Agentverse inspector. It IS needed
# for the "Launch an Agent -> External Integration -> uAgents"
# registration script and for the Agentverse CLI.
AGENTVERSE_TOKEN=

# The agent's seed phrase. This decides the agent's address, so keep it
# the same across restarts. Any string works; a 24-word mnemonic is the
# convention (https://pypi.org/project/mnemonic/).
HEALTHYFY_AGENT_SEED=

# The Healthyfy app this agent reads from
HEALTHYFY_BASE_URL=http://localhost:3000
HEALTHYFY_EMAIL=kartik@healthyfy.ai
HEALTHYFY_PASSWORD=healthyfy123
HEALTHYFY_DEFAULT_MEMBER=
