MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=healthyfy
# Required for production JWT signing. Use a long random value.
JWT_SECRET=your_random_jwt_secret_here

# -------------------------------------------------------------
# Model backend
#
# AI_PROVIDER pins the PREFERRED provider. Each job still has a
# fallback chain, so the app keeps working if one provider is down:
#
#   app features  -> gemini -> asi-one -> openai-compatible
#   document OCR  -> gemini -> asi-one
#   the uAgent    -> asi-one -> gemini
#
# AI_PROVIDER:
#   gemini            - Google Gemini            (needs GEMINI_API_KEY)
#   asi-one           - ASI:One from Fetch.ai    (needs ASI1_API_KEY)
#   openai-compatible - any OpenAI chat-completions endpoint
#
# For a Fetch.ai submission, pin asi-one:
#   AI_PROVIDER=asi-one
# -------------------------------------------------------------
AI_PROVIDER=gemini

# Google Gemini - report analysis, document vision, the chat assistant.
GEMINI_API_KEY=
# Optional: override the Gemini model used for report analysis and chat.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# ASI:One (Fetch.ai) - the uAgent's brain, and the app's fallback.
# Get a key at https://asi1.ai/developer
# The name is ASI_ONE_API_KEY in the ASI:One docs; ASI1_API_KEY also works.
ASI1_API_KEY=
# AI_BASE_URL=https://api.asi1.ai/v1
# AI_MODEL=asi1
# ASI1_MODEL=asi1
# AI_FALLBACK_MODELS=asi1
# AI_JSON_MODE=json_schema
# AI_TIMEOUT_MS=120000

# -------------------------------------------------------------
# uAgent (services/healthyfy-agent)
#
# Set this to the address the uAgent logs on startup so the web app
# can link to the agent's Agentverse profile.
# -------------------------------------------------------------
HEALTHYFY_AGENT_NAME=healthyfy-health-agent
HEALTHYFY_AGENT_ADDRESS=
HEALTHYFY_AGENT_SEED=

# Optional: real push delivery to a phone via Firebase Cloud Messaging.
# Without these, alerts land in the in-app notification inbox only.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Optional: background scheduler that drives medication, hydration and
# exercise reminders, alert escalation and the daily briefing.
# SCHEDULER_ENABLED=true
# SCHEDULER_TICK_MS=30000

# Optional: use the NIH RxNorm service to canonicalise drug names.
# RXNORM_ENABLED=true

PORT=3000
NODE_ENV=development
